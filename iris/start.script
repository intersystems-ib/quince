zn "RUGBY"
if ##class(%Dictionary.ClassDefinition).%ExistsId("Ens.Director") { set sc=##class(Ens.Director).GetProductionStatus(.running,.state) if (state=1)||(state=4) { if running'="Rugby.Interop.Production" { write "Another production is already running",! halt } if state=4 { set sc=##class(Ens.Director).RecoverProduction() if $SYSTEM.Status.IsError(sc) { do $SYSTEM.Status.DisplayError(sc) halt } } set sc=##class(Ens.Director).StopProduction(30) if $SYSTEM.Status.IsError(sc) { do $SYSTEM.Status.DisplayError(sc) halt } } }
zn "%SYS"
set sc=##class(%Library.EnsembleMgr).EnableNamespace("RUGBY",1)
if $SYSTEM.Status.IsError(sc) do $SYSTEM.Status.DisplayError(sc) halt
set apiProperties("IsNameSpaceDefault")=0
set sc=##class(Security.Applications).Modify("/api/v1",.apiProperties)
if $SYSTEM.Status.IsError(sc) do $SYSTEM.Status.DisplayError(sc) halt
kill apiProperties
zn "RUGBY"
set sc=$SYSTEM.OBJ.LoadDir("/opt/rugby/src","ck",,1)
if $SYSTEM.Status.IsError(sc) do $SYSTEM.Status.DisplayError(sc) halt
do ##class(Rugby.Interop.Runtime).Start()
halt
