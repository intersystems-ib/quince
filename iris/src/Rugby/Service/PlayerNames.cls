ClassMethod French(seed As %Integer) As %String
{
    // Independent digest bytes avoid correlated names for neighbouring seeds.
    set given=..FrenchGiven(),last=..FrenchSurnames(),digest=$system.Encryption.SHAHash(256,"rugby-french-name-v2|"_seed),first=0,family=0
    for i=1:1:4 { set first=(first*256)+$ascii(digest,i),family=(family*256)+$ascii(digest,i+4) }
    quit $list(given,1+(first#$listlength(given)))_" "_$list(last,1+(family#$listlength(last)))
}
