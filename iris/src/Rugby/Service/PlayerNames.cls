ClassMethod Spanish(seed As %Integer, professional As %Boolean = 0) As %String
{
    set given=..SpanishGiven(professional),last=..SpanishSurnames(),digest=$system.Encryption.SHAHash(256,"rugby-spanish-name-v2|"_seed),first=0,family1=0,family2=0
    for i=1:1:4 { set first=(first*256)+$ascii(digest,i),family1=(family1*256)+$ascii(digest,i+4),family2=(family2*256)+$ascii(digest,i+8) }
    set a=1+(family1#$listlength(last)),b=1+(family2#($listlength(last)-1))
    if b>=a set b=b+1
    quit $list(given,1+(first#$listlength(given)))_" "_$list(last,a)_" "_$list(last,b)
}
